            "public_dns": "ec2-44-204-107-172.compute-1.amazonaws.com",
            "public_ip": "44.204.107.172",
            "region": "us-east-1",
            "root_block_device": [
              {
                "delete_on_termination": true,
                "device_name": "/dev/xvda",
                "encrypted": false,
                "iops": 100,
                "kms_key_id": "",
                "tags": {},
                "tags_all": {},
                "throughput": 0,
                "volume_id": "vol-00aa83abfb78dce4b",
